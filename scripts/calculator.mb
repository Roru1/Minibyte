main(
run primary
)

primary(
clr
prt "1: Addition"
prt "2: Subtraction"
prt "3: Multiplication"
prt "4: Division"
qry type
ctn check ["1","2","3","4"] type 
iff check request
iff not check primary
)

request(
clr
prt "Enter First Number:"
qry a
int a a
clr
prt "Enter Second Number:"
qry b
int b b
clr
prt "calculating"
slp 2
clr
run calculate
)

calculate(
int type type
iff type==1 addition
iff type==2 subtraction
iff type==3 multiplication
iff type==4 division
)

addition(
add c a b
jns t a " + " b " = " c
prt t
)

subtraction(
sub c a b
jns t a " - " b " = " c
prt t
)

multiplication(
mul c a b
jns t a " x " b " = " c
prt t
)

division(
div c a b
jns t a " / " b " = " c
prt t
)
